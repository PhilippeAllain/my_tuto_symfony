{% extends 'admin/admin.html.twig' %}

{% block title 'Toutes les catégories' %}

{% block body %}

	<h1 class="text-center">Liste des catégories</h1>

	<p>
		<a class="btn btn-primary" href="{{ path('admin.category.create') }}">Créer une catégorie.</a>
	</p>

	<table class="table table-bordered border border-3 border-success">
		<thead>
			<tr>
				<th class="text-center" style="width: 50px">{{ knp_pagination_sortable(categories, 'ID', 'c.id') }}</th>
				<th>{{ knp_pagination_sortable(categories, 'Nom', 'c.name') }}</th>
				<th class="text-center" style="width: 217px">Actions</th>
			</tr>
		</thead>

		<tbody>
			{% for category in categories %} 
				<tr>
					<td class="text-center">
						{{ category.id }}
					</td>
					<td class="text-start">
						<a href="{{ path('admin.category.edit', { id: category.id }) }}">{{ category.name }}</a>
					</td>
					
					<td>
						<div class="d-grid gap-2 d-md-flex justify-content-md-center">
							<a class="btn btn-primary btn-sm" href="{{ path('admin.category.edit', {id : category.id}) }}">Editer</a>
							<form action="{{ path('admin.category.delete', {id: category.id}) }}" method="POST">
								<input type="hidden" name="_method" value="DELETE">
								<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
								<button class="btn btn-danger" type="submit">Supprimer</button>
							</form>
						</div>
					</td>
				</tr>

			{% endfor %}
		</tbody>
	</table>

	<div class="d-flex justify-content-center">
		{{ knp_pagination_render(categories) }}
	</div>

{% endblock %}
