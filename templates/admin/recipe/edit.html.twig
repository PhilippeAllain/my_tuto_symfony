{% extends 'admin/admin.html.twig' %}

{% block title 'Editer la recette: ' ~ recipe.title %}

{% block body %}

	<div class="container">
		<h1>{{ recipe.title }}</h1>

		<img src="{{ vich_uploader_asset(recipe, 'thumbnailFile') }}" alt="{{ recipe.title }}" height="200" width="300" class="img-fluid mb-3">

		<turbo-frame id="recipe_{{ recipe.id }}">
			{{ form(form, {action: path('admin.recipe.edit', {id: recipe.id})}) }}
			</turbo-frame>

		</div>

	{% endblock %}
